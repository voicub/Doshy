# Copy to .env.local. All values are read on the server only and never sent to the browser.

# Required: your Home Assistant and a long-lived access token (profile page > Security)
HA_URL=https://your-home-assistant
HA_TOKEN=long-lived-access-token

# Optional: lets you download real 3D car models (README, Cars)
# SKETCHFAB_TOKEN=your-sketchfab-api-token

# Optional: "off" stops the sun-blocking curtains from closing at dawn by themselves (docs/curtains.md)
# HOUSEY_AUTOMATION=off

# Optional: where the SQLite database lives (default data/housey.db; docs/database.md)
# HOUSEY_DB_PATH=/var/lib/housey/housey.db

# Optional: Surroundings satellite photo (docs/site.md). The default is Esri World Imagery.
# SITE_TILE_URL=https://tiles.example.com/{z}/{y}/{x}
# SITE_TILE_MAX_ZOOM=19
# SITE_TILE_CREDIT=Imagery: Example
# HOUSEY_SITE_CACHE=data/site-cache   # where fetched map data and tiles are cached

# Optional, development only (`next dev`): LAN addresses you open the dev server from, comma separated
# DOSHY_DEV_ORIGINS=192.168.1.20,192.168.1.21
